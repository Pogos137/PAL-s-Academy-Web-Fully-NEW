# --- Identity / Email ---
ADMIN_EMAIL=palseduacademy@gmail.com
EMAIL_FROM="PAL's Academy <palseduacademy@gmail.com>"
EMAIL_REPLY_TO=palseduacademy@gmail.com
ADMIN_NOTIFY_EMAIL=palseduacademy@gmail.com

# --- Calendly (leave blank to show "schedule via email" fallback) ---
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/your-handle/free-consultation

# --- Local auth (built-in file store) ---
AUTH_SESSION_SECRET=replace-with-a-long-random-string

# --- Supabase (required for persistent data on Vercel) ---
# Get these from supabase.com → your project → Settings → General (URL)
# and Settings → API Keys → Secret key
SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
SUPABASE_SECRET_KEY=sb_secret_YOUR_SECRET_KEY

# --- Optional: Resend for real emails ---
RESEND_API_KEY=re_YOUR_KEY

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
